# Copiar a .env.production (NO commitear secretos reales)
# docker compose --env-file .env.production up -d --build

# ——— Obligatorio MVP (email + LinkedIn + Calendar) ———
NEXUS_REAL_MODE=1
NEXUS_SKIP_DEMO_SEED=1
NEXUS_ALLOW_WORKSPACE_SIGNUP=1

NEXUS_JWT_SECRET=cambiar-por-string-largo-aleatorio
NEXUS_TOKEN_FERNET_KEY=

# URL pública del SPA Sales (Docker local: http://localhost:8080)
NEXUS_FRONTEND_URL=http://localhost:8080
# Sales + Support (ops). En prod: https://nexus.tu-dominio.com,https://support.tu-dominio.com
NEXUS_CORS_ORIGINS=http://localhost:8080,http://localhost:8081

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google OAuth — en consola Google agregá:
#   https://TU_DOMINIO/auth/google/callback  (si API va por el mismo host vía nginx)
#   o http://localhost:8002/auth/google/callback (API expuesto directo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8002/auth/google/callback
GOOGLE_OAUTH_STATE_SECRET=

# Nexus Support (app aparte, puerto 8081 en Docker) — emails del equipo ops.
# Sin esto, owner/gerente de NEXUS_OPS_COMPANY_ID (default 1).
# NEXUS_SUPPORT_OPS_EMAILS=ops@tu-dominio.com
# NEXUS_OPS_COMPANY_ID=1

# CRM del cliente (OAuth). Redirect: https://TU_API/auth/hubspot/callback y /auth/salesforce/callback
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=https://TU_API/auth/hubspot/callback
# HUBSPOT_ENABLED=1
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_REDIRECT_URI=https://TU_API/auth/salesforce/callback
# SALESFORCE_ENABLED=1
# CRM_OAUTH_STATE_SECRET=

# Empezá con automatización apagada; activá tras validar OAuth
NEXUS_AUTO_SEND_ENABLED=0
NEXUS_AUTOMATION_SCHEDULER=0
ENABLE_GMAIL_AUTOMATION=0

# SMTP — “Olvidé mi contraseña” (código al mail corporativo del vendedor)
# NEXUS_SMTP_HOST=smtp.gmail.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USER=
# NEXUS_SMTP_PASSWORD=
# NEXUS_SMTP_FROM=Nexus Sales <noreply@tu-dominio.com>
# NEXUS_SMTP_TLS=1

# ——— WhatsApp Web asistido (v1 producción): NO requiere Meta Cloud ———
# La extensión Chrome abre WhatsApp Web; dejá vacío WHATSAPP_* salvo que uses API Cloud aparte.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
