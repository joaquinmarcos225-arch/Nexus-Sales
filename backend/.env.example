# =============================================================================
# Nexus Sales — variables de entorno (copiar a .env)
# Guía: ../README.md (dev) · ../docs/PRODUCTION.md (deploy)
# =============================================================================

# Auth JWT (obligatorio en producción — no usar el default de security.py)
# NEXUS_JWT_SECRET=

# Alta de empresas desde /registro (frontend). En producción dejar en 0 salvo self-service.
# NEXUS_ALLOW_WORKSPACE_SIGNUP=1

BRAVE_SEARCH_API_KEY=
# SERPAPI_API_KEY=
# WEB_SEARCH_PROVIDER=brave
# Lead Sourcing: umbral de etiqueta "Bajo fit" (no oculta leads; solo marca). Testing: 30
# LEAD_SOURCING_MIN_DISPLAY_SCORE=30
PROSPEO_API_KEY=
# Enrich MVP: empresas ICP por run (search-person + enrich-company)
# PROSPEO_MAX_COMPANIES_PER_ENRICH=5
# PROSPEO_PEOPLE_PER_COMPANY=2
# Insert manual: tope (segundos) para buscar email/WhatsApp faltantes antes de arrancar
# MANUAL_CHANNEL_ENRICH_MAX_SECONDS=45
# Generar outreach automático tras enrich (requiere OPENAI_API_KEY)
# MVP_OUTREACH_GENERATE_LIMIT=5

# OpenAI (mensajes de secuencia, inbound, sourcing)
# Definidas en backend/.env — el backend las lee al iniciar uvicorn.
# OPENAI_API_KEY=sk-proj-...
# OPENAI_MODEL=gpt-4.1-mini
#
# Fallback dev: si OpenAI devuelve rate limit, genera mensaje mock [FALLBACK TEST]
# y permite continuar la secuencia. Activo por defecto con APP_ENV=development o TEST_MODE=true.
# NEXUS_OPENAI_FALLBACK_ON_RATE_LIMIT=1

# Google OAuth (SDR / AE — Gmail + Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8002/auth/google/callback

# Firma del parámetro `state` (recomendado: secreto largo aleatorio; si no, se usa GOOGLE_CLIENT_SECRET)
GOOGLE_OAUTH_STATE_SECRET=

# Cifrado de tokens en BD (Fernet, 32 bytes url-safe base64). Generar:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
NEXUS_TOKEN_FERNET_KEY=

# WhatsApp: producto = Web asistido (extensión), como LinkedIn.
# Cloud API de Meta es opt-in (no el default):
# WHATSAPP_USE_CLOUD_API=1
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_API_VERSION=v21.0
# Webhook Meta (solo si usás Cloud API):
# WHATSAPP_WEBHOOK_ENABLED=1
# WHATSAPP_WEBHOOK_VERIFY_TOKEN=nexus_wa_verify_change_me
# WHATSAPP_APP_SECRET=
# NO usar dry-run en producto (deja la UI en "modo prueba"):
# WHATSAPP_DRY_RUN=0
#
# Plantillas Meta (solo Cloud API — contacto en frío).
# La plantilla debe tener 3 variables: {{1}} nombre, {{2}} empresa, {{3}} mensaje.
# WHATSAPP_TEMPLATE_NAME=nexus_sequence
# WHATSAPP_TEMPLATE_DAY7=nexus_sequence_d7
# WHATSAPP_TEMPLATE_DAY16=nexus_sequence_d16
# WHATSAPP_TEMPLATE_LANGUAGE=es

# Sync CRM automático (exclusiones pull + reintento push de actividades)
# NEXUS_CRM_EXCLUSIONS_INTERVAL_SEC=3600
# NEXUS_CRM_OUTBOUND_INTERVAL_SEC=900

# HubSpot CRM (OAuth por empresa — sync contactos + notas al enviar secuencia)
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=http://127.0.0.1:8002/auth/hubspot/callback
# Legacy (opcional, una sola org en el servidor):
# HUBSPOT_ACCESS_TOKEN=pat-...
# HUBSPOT_ENABLED=1

# Salesforce CRM (OAuth por empresa — sync contactos + tareas al enviar secuencia)
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_REDIRECT_URI=http://127.0.0.1:8002/auth/salesforce/callback
# SALESFORCE_LOGIN_URL=https://login.salesforce.com
# SALESFORCE_API_VERSION=v59.0
# Legacy (opcional, una sola org en el servidor):
# SALESFORCE_REFRESH_TOKEN=
# SALESFORCE_INSTANCE_URL=https://tuorg.my.salesforce.com
# SALESFORCE_ENABLED=1

# Tras OAuth, redirección al frontend (sin barra final)
NEXUS_FRONTEND_URL=http://127.0.0.1:5173

# =============================================================================
# Billing (suscripción automática — ver docs/BILLING.md)
# =============================================================================
# BILLING_DEV_MODE=1
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CURRENCY=usd
# MERCADOPAGO_ACCESS_TOKEN=APP_USR_...
# MP_CURRENCY=ARS
# Precios placeholder (ajustá antes de cobrar en serio):
# BILLING_PRICE_STARTER_CENTS=30000
# BILLING_PRICE_GROWTH_CENTS=50000
# BILLING_PRICE_SCALER_CENTS=70000
# BILLING_PRICE_ELITE_CENTS=92000

# CORS adicional (CSV). Si vacío, usa localhost + NEXUS_FRONTEND_URL
# NEXUS_CORS_ORIGINS=http://127.0.0.1:5173,https://app.tu-dominio.com

# Modo solo datos reales (recomendado en producción): sin seed demo, sin simulaciones de outreach,
# sin toques automáticos 21d en BD, sin follow-ups simulados; métricas dashboard solo Gmail API real.
# Valores: 1, true, yes, on
# NEXUS_REAL_MODE=1

# Modo solo datos reales: deshabilita simulación inbound en autopilot y endpoints POST …/simulate-response(s)
# Valores: 1, true, yes, on
# NEXUS_DISABLE_OUTREACH_SIMULATION=1

# Testing manual de secuencias SDR (Simular respuesta en Ver Secuencia).
# Funciona AUNQUE NEXUS_REAL_MODE=1 — recomendado en desarrollo local.
# Valores: 1, true, yes, on
# NEXUS_ENABLE_SEQUENCE_TESTING=1

# Autonomous loop (NEXUS_REAL_MODE): scheduler en proceso uvicorn. Intervalos en segundos.
# NEXUS_AUTOMATION_SCHEDULER=1
# Automatización Gmail en background (inbound, refresh OAuth, calendar sync con Google). Default: off.
# ENABLE_GMAIL_AUTOMATION=0
# ENABLE_GMAIL_AUTOMATION=1
# NEXUS_GMAIL_POLL_INTERVAL_SEC=45
# NEXUS_LOG_LEVEL=INFO
# Timeout HTTP dashboard (companies, analytics, campaigns). Default 25s → JSON 504.
# NEXUS_HTTP_DASHBOARD_TIMEOUT_SEC=25
# Respuesta automática tras inbound Gmail (borrador o envío según campaña). Default: activo.
# NEXUS_INBOUND_AUTO_REPLY=1
# NEXUS_INBOUND_REPLY_POLL_INTERVAL_SEC=45
# NEXUS_CALENDAR_SYNC_INTERVAL_SEC=300
# NEXUS_FOLLOWUPS_POLL_INTERVAL_SEC=180
# NEXUS_INITIAL_OUTREACH_INTERVAL_SEC=90
# Día 1: contactar a todos los elegibles en el mismo tick (default 500).
# NEXUS_INITIAL_OUTREACH_BATCH_SIZE=500
# Toques automáticos días 4–19 (email/WhatsApp + cola LinkedIn). Default: on con scheduler + real mode.
# NEXUS_SEQUENCE_TOUCHES_ENABLED=1
# NEXUS_SEQUENCE_TOUCH_INTERVAL_SEC=120
# NEXUS_SEQUENCE_TOUCH_BATCH_SIZE=500
# Refill automático hasta prospect_count en campañas activas (import pipeline + MVP).
# NEXUS_SOURCING_REFILL_ENABLED=1
# NEXUS_SOURCING_REFILL_INTERVAL_SEC=120
# NEXUS_SOURCING_REFILL_MAX_CAMPAIGNS_PER_TICK=2
# LEAD_SOURCING_AUTO_MAX_PASSES=2
# LEAD_SOURCING_AUTO_COMPANY_LIMIT=15

# Envío automático de emails (solo si la campaña tiene outreach_email_mode=auto_send). Requiere doble consentimiento.
# NEXUS_AUTO_SEND_ENABLED=1
# NEXUS_AUTO_SEND_HOURLY_CAP=500
# Topes diarios por SDR (defaults en código: email 300, LI conexiones 40, LI mensajes 30, WA 20 +1 por respuesta inbound)
# NEXUS_DAILY_LIMIT_EMAIL=300
# NEXUS_DAILY_LIMIT_LINKEDIN_INVITE=40
# NEXUS_DAILY_LIMIT_LINKEDIN_DM=30
# NEXUS_DAILY_LIMIT_WHATSAPP=20

# No crear empresa/usuarios demo al arrancar (dashboard sin fila CostGuard Demo)
# NEXUS_SKIP_DEMO_SEED=1

# Web Push (opcional). Si vacío, se generan en backend/data/vapid.json
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:ops@tu-dominio.com

# Nexus Support (app aparte, no Sales): emails del equipo. Si vacío, owner/gerente de NEXUS_OPS_COMPANY_ID (default 1).
# NEXUS_SUPPORT_OPS_EMAILS=joaquin@tu-dominio.com
# NEXUS_OPS_COMPANY_ID=1

# SMTP para “Olvidé mi contraseña” (código al mail del usuario). Obligatorio en producción.
# NEXUS_SMTP_HOST=smtp.gmail.com
# NEXUS_SMTP_PORT=587
# NEXUS_SMTP_USER=nexus@tu-dominio.com
# NEXUS_SMTP_PASSWORD=
# NEXUS_SMTP_FROM=Nexus Sales <nexus@tu-dominio.com>
# NEXUS_SMTP_TLS=1
# Solo local, sin SMTP: devolver el código en la respuesta JSON (nunca en prod).
# NEXUS_PASSWORD_RESET_DEV_ECHO=1

# Reinicio de entorno de pruebas (solo desarrollo; botón visible para Gerente)
# APP_ENV=development
# TEST_MODE=true
