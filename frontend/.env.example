# URL del API FastAPI (puerto debe coincidir con uvicorn). Reiniciá `npm run dev` tras cambiar esto.
VITE_API_URL=http://127.0.0.1:8002

# Objetivo del proxy de Vite (opcional; por defecto usa VITE_API_URL).
# VITE_PROXY_TARGET=http://127.0.0.1:8002

# En dev, por defecto Vite hace proxy y el navegador usa URLs relativas (evita CORS).
# Para forzar fetch directo a VITE_API_URL desde el browser: descomentar la línea de abajo.
# VITE_DEV_PROXY=0

# Mostrar botones manuales de Gmail/Calendar (debug). Por defecto ocultos en la UI operativa.
# VITE_SHOW_OPS_DEBUG=true
